{
  "id": "simulator-unavailable-devices",
  "title": "Simulator devices",
  "explanation": "Each simulator keeps its installed apps and data here. Select the individual devices you want Xcode to delete.",
  "consequence": "Devices you can still run stay as they are, and Xcode creates new ones when you add a runtime.",
  "paths": [
    "~/Library/Developer/CoreSimulator/Devices"
  ],
  "sizing": "allocated-walk",
  "bucket": "developer",
  "tier": "safe",
  "removal": {
    "kind": "tool",
    "executable": "/usr/bin/xcrun",
    "arguments": [
      "simctl",
      "delete",
      "unavailable"
    ]
  },
  "apps_must_be_quit": [],
  "requires_tool": "/usr/bin/xcrun",
  "verified_on": [
    26,
    27
  ],
  "sources": [
    "https://developer.apple.com/forums/thread/773153",
    "https://furbo.org/2022/11/09/managing-xcode-downloads",
    "https://mjtsai.com/blog/?p=48956"
  ],
  "last_verified": "2026-11-02"
}
